{
  "name": "ola-ride-booking-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend services for the Ola Ride Booking Dashboard application",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run dev --prefix frontend\"",
    "seed": "node utils/seeder.js",
    "build": "npm run build --prefix frontend",
    "install-all": "npm install && npm install --prefix frontend"
  },
  "dependencies": {
    "@clerk/react": "^6.12.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
